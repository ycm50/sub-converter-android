# ===========================================================================
# subconverter (Android) —— 不进版本库的东西
#
# 约定：构建配置全在 Gradle 里（build.gradle.kts / settings.gradle.kts /
# gradle/libs.versions.toml / gradle.properties），IDE 状态一律不进库。
# 每一项为什么被忽略、哪些「像产物其实必须提交」，README 的「仓库约定」一节有对照表。
# ===========================================================================

# ---------------------------------------------------------------------------
# 只对某台机器成立的东西
# ---------------------------------------------------------------------------
# local.properties 里是 sdk.dir 这类绝对路径。它由 Android Studio 生成，
# 而且每次 Sync 都会被 Studio 按自己的设置重写（README「本机环境」有现场记录）。
# 提交它只会在别人机器上指向一个不存在的 SDK —— 让每个人自己生成。
local.properties

# ---------------------------------------------------------------------------
# 构建产物：可再生产，而且很大（本机 app/.cxx 就 400+ MB）
# ---------------------------------------------------------------------------
build/
.gradle/
.cxx/
.externalNativeBuild/
captures/

# tools/build-native.ps1 -Install 的落点：编出来的 .so 再拷一份进 jniLibs。
# 它仍然是**产物**，不是源码 —— 本工程进包的那份 .so 由 AGP 的 externalNativeBuild
# 现场编（见 README「本机环境」）；只有把 externalNativeBuild 关掉、改走 jniLibs 时
# 它才会变成「必须提交」的东西，那时用 git add -f 单独放行。
app/src/main/jniLibs/

# 打出来的包
*.apk
*.aab
*.ap_
*.apk.sha1

# ---------------------------------------------------------------------------
# 同步上游时的中间产物
# ---------------------------------------------------------------------------
# ./gradlew syncUpstream -Psubconv.reject=true 会把套不上的补丁落成 .rej（落在
# app/src/main/cpp 这份**被跟踪**的目录里），git apply 也可能留下 .orig；
# 它们是人工处理冲突的现场，处理完就该消失 —— 别让它们混进提交。
*.rej
*.orig

# ---------------------------------------------------------------------------
# IDE 状态
# ---------------------------------------------------------------------------
# 本机 .idea 下只有一个 workspace.xml，没有任何值得共享的配置，所以整体忽略。
# 以后要共享 code style / inspection / run configuration，用 git add -f 单独放行。
.idea/
*.iml

# ---------------------------------------------------------------------------
# 签名材料：私钥永远不要进库
# ---------------------------------------------------------------------------
*.jks
*.keystore
keystore.properties
signing.properties

# ---------------------------------------------------------------------------
# 系统垃圾
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ===========================================================================
# 下面这些「看起来像产物，其实必须提交」，别加规则把它们排掉：
#
#   gradle/wrapper/gradle-wrapper.jar     没有它 gradlew 就跑不起来
#   gradle/wrapper/*.properties           wrapper 自己下载哪个版本的老 Gradle
#   gradle/libs.versions.toml             依赖版本
#   gradle/gradle-daemon-jvm.properties   守护进程要用的 JDK toolchain
#   app/src/main/cpp/third_party/         依赖是 vendor 进来的，为的就是离线可构建
#   app/src/main/cpp/data/web/index.html  上游 Web UI，配置期 file(READ) 内嵌进 .so
# ===========================================================================
